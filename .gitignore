# Zip archives (redundant with folders)
*.zip

# Old/duplicate transcript batches
transcripts1/
transcripts2/
transcripts4/
transcripts5/

# Jupyter notebook checkpoints
**/.ipynb_checkpoints/
.ipynb_checkpoints/

# Empty placeholder directories
audio_files/
Baseline_Info/

# Trained model binary
Scripts/Knowledge_Agent_Model.pkl

# API keys — never commit these
rubrics/youtube_API.txt
.env
*.env

# OS files
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/
*.pyc

# Dedicated venv for the embedding representation (torch>=2.1 needed;
# the default environment has torch 2.0.1). Rebuild with:
#   python3 -m venv .venv-embeddings
#   .venv-embeddings/bin/pip install torch --index-url https://download.pytorch.org/whl/cu121
#   .venv-embeddings/bin/pip install transformers sentence-transformers numpy pandas \
#       scikit-learn lightgbm imbalanced-learn openpyxl isodate
.venv-embeddings/

# Gold-set annotation safety backups (merge_gold_annotations.py writes
# these automatically before every overwrite; local safety net, not
# meant to accumulate in git history)
outputs/gold_backups/

# LaTeX build artifacts (Overleaf/latexmk regenerates these; only source
# files and the compiled PDF are worth tracking)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
